===================== 3.2.1 数据预处理代码 =====================
-- 1. 查看数据表结构
DESCRIBE new_user_behavior;

-- 2. 筛选新用户，创建临时表（直接筛选，不做复杂处理）
CREATE TEMPORARY TABLE IF NOT EXISTS new_user_temp AS
SELECT * FROM new_user_behavior WHERE new_user = '1';

-- 3. 无需去重（数据无重复记录，跳过去重步骤）

-- 4. 缺失值填充（直接批量填充，不查看缺失值）
UPDATE new_user_temp 
SET 
    age = IFNULL(age, '28'),
    sex = IFNULL(sex, '0'),
    device = IFNULL(device, '0'),
    operative_system = IFNULL(operative_system, '0'),
    source = IFNULL(source, 'unknown');

-- 5. 异常值过滤（直接筛选，不创建临时表）
DELETE FROM new_user_temp
WHERE CAST(total_pages_visited AS UNSIGNED) NOT BETWEEN 1 AND 28
OR CAST(home_page AS UNSIGNED) != 1
OR CAST(listing_page AS UNSIGNED) NOT IN (0,1)
OR CAST(product_page AS UNSIGNED) NOT IN (0,1)
OR CAST(payment_page AS UNSIGNED) NOT IN (0,1)
OR CAST(confirmation_page AS UNSIGNED) NOT IN (0,1)
OR CAST(market AS UNSIGNED) NOT IN (1,2,3,4)
OR sex NOT IN ('male', 'female', '0')
OR device NOT IN ('0', 'desktop', 'mobile')
OR operative_system NOT IN ('0', 'android', 'iOS', 'linux', 'mac', 'other', 'windows');

-- 6. 查看清洗后的数据量
SELECT COUNT(*) AS valid_user_count FROM new_user_temp;

===================== 3.2.2 用户整体概况统计代码 =====================
SET @total_user = (SELECT COUNT(*) FROM new_user_temp);

-- 1. 年龄分布统计
SELECT 
    age,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY age
ORDER BY user_count DESC;

-- 2. 性别分布统计
SELECT 
    sex,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY sex
ORDER BY user_count DESC;

-- 3. 市场分布统计
SELECT 
    market,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY market
ORDER BY user_count DESC;

-- 4. 设备与操作系统分布统计
SELECT 
    device,
    operative_system,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY device, operative_system
ORDER BY user_count DESC;

-- 5. 流量来源渠道分布
SELECT 
    source,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY source
ORDER BY user_count DESC;

-- 6. 访问深度统计
SELECT 
    CASE 
        WHEN CAST(total_pages_visited AS UNSIGNED) BETWEEN 1 AND 9 THEN '浅度浏览（1-9页）'
        WHEN CAST(total_pages_visited AS UNSIGNED) BETWEEN 10 AND 19 THEN '中度浏览（10-19页）'
        ELSE '深度浏览（20-28页）'
    END AS visit_depth,
    COUNT(*) AS user_count,
    CONCAT(ROUND(COUNT(*)*100.0/@total_user, 2), '%') AS user_ratio
FROM new_user_temp
GROUP BY visit_depth
ORDER BY user_count DESC;

===================== 3.2.3 转化漏斗分析代码 =====================
WITH funnel AS (
    SELECT
        COUNT(*) AS home_user,
        SUM(CASE WHEN CAST(listing_page AS UNSIGNED) = 1 THEN 1 ELSE 0 END) AS listing_user,
        SUM(CASE WHEN CAST(product_page AS UNSIGNED) = 1 THEN 1 ELSE 0 END) AS product_user,
        SUM(CASE WHEN CAST(payment_page AS UNSIGNED) = 1 THEN 1 ELSE 0 END) AS payment_user,
        SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED) = 1 THEN 1 ELSE 0 END) AS confirm_user
    FROM new_user_temp
)
SELECT
    home_user AS 首页用户数,
    listing_user AS 列表页用户数,
    CONCAT(ROUND(listing_user*100.0/home_user, 2), '%') AS 首页到列表页转化率,
    product_user AS 详情页用户数,
    CONCAT(ROUND(product_user*100.0/listing_user, 2), '%') AS 列表页到详情页转化率,
    payment_user AS 支付页用户数,
    CONCAT(ROUND(payment_user*100.0/product_user, 2), '%') AS 详情页到支付页转化率,
    confirm_user AS 确认页用户数,
    CONCAT(ROUND(confirm_user*100.0/payment_user, 2), '%') AS 支付页到确认页转化率,
    CONCAT(ROUND(confirm_user*100.0/home_user, 2), '%') AS 整体转化率
FROM funnel;

===================== 3.2.4 多维度转化差异分析代码 =====================
-- 年龄维度
SELECT 
age,
COUNT(*) AS user_count,
CONCAT(ROUND(SUM(CASE WHEN CAST(payment_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS product_to_payment_conv,
CONCAT(ROUND(SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS total_conv_rate
FROM new_user_temp
GROUP BY age
ORDER BY total_conv_rate DESC;

-- 性别维度
SELECT 
sex,
COUNT(*) AS user_count,
CONCAT(ROUND(SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS total_conv_rate
FROM new_user_temp
GROUP BY sex
ORDER BY total_conv_rate DESC;

-- 市场维度
SELECT 
market,
COUNT(*) AS user_count,
CONCAT(ROUND(SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS total_conv_rate
FROM new_user_temp
GROUP BY market
ORDER BY total_conv_rate DESC;

-- 设备与操作系统维度
SELECT 
device,
operative_system,
COUNT(*) AS user_count,
CONCAT(ROUND(SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS total_conv_rate
FROM new_user_temp
GROUP BY device, operative_system
ORDER BY total_conv_rate DESC;

-- 流量渠道维度
SELECT 
source,
COUNT(*) AS user_count,
CONCAT(ROUND(SUM(CASE WHEN CAST(confirmation_page AS UNSIGNED)=1 THEN 1 ELSE 0 END)*100.0/COUNT(*),2),'%') AS total_conv_rate,
ROUND(AVG(CAST(total_pages_visited AS UNSIGNED)),2) AS avg_visit_pages
FROM new_user_temp
GROUP BY source
ORDER BY total_conv_rate DESC;

===================== 3.2.5 新用户典型画像筛选代码 =====================
-- 高转化用户
CREATE TEMPORARY TABLE high_conv_user AS
SELECT * FROM new_user_temp
WHERE CAST(confirmation_page AS UNSIGNED) = 1 
AND CAST(total_pages_visited AS UNSIGNED) >= 10;

SELECT 
age, sex, market, device, operative_system, source,
COUNT(*) AS user_count,
ROUND(AVG(CAST(total_pages_visited AS UNSIGNED)),2) AS avg_visit_pages
FROM high_conv_user
GROUP BY age, sex, market, device, operative_system, source
ORDER BY user_count DESC;

-- 低转化（活跃观望）用户
CREATE TEMPORARY TABLE wait_user AS
SELECT * FROM new_user_temp
WHERE CAST(confirmation_page AS UNSIGNED) = 0 
AND CAST(product_page AS UNSIGNED) = 1;

SELECT 
age, sex, market, device, operative_system, source,
COUNT(*) AS user_count
FROM wait_user
GROUP BY age, sex, market, device, operative_system, source
ORDER BY user_count DESC
LIMIT 10;
